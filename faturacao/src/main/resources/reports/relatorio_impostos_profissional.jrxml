<?xml version="1.0" encoding="UTF-8"?>
<!-- Relatório de Impostos - Sistema Kubata -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="relatorio_impostos" 
              pageWidth="595" 
              pageHeight="842" 
              orientation="Portrait" 
              whenNoDataType="AllSectionsNoDetail" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="30" 
              bottomMargin="30">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Sample DB"/>
    <property name="com.jaspersoft.studio.unit." value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
    <property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>

    <!-- Estilos Profissionais -->
    <style name="Title" fontSize="18" isBold="true"/>
    <style name="Subtitle" fontSize="12" isBold="false" forecolor="#666666"/>
    <style name="Header" fontSize="10" isBold="true" backcolor="#F0F4F8"/>
    <style name="Detail" fontSize="9" isBold="false"/>
    <style name="Total" fontSize="10" isBold="true" backcolor="#E8F5E8"/>
    <style name="Highlight" fontSize="10" isBold="true" forecolor="#1976D2"/>
    <style name="TableHeader" fontSize="9" isBold="true" backcolor="#1976D2" forecolor="white"/>
    <style name="TableDetail" fontSize="9" isBold="false"/>
    <style name="TableTotal" fontSize="9" isBold="true" backcolor="#F5F5F5"/>
    <style name="Footer" fontSize="8" isBold="false" forecolor="#666666"/>

    <!-- Parâmetros -->
    <parameter name="PERIODO_INICIO" class="java.lang.String"/>
    <parameter name="PERIODO_FIM" class="java.lang.String"/>
    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>
    <parameter name="EMPRESA_ENDERECO" class="java.lang.String"/>
    <parameter name="EMPRESA_TELEFONE" class="java.lang.String"/>
    <parameter name="EMPRESA_EMAIL" class="java.lang.String"/>
    <parameter name="LOGO_PATH" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="DATA_EMISSAO" class="java.util.Date"/>

    <!-- Campos do dataset -->
    <field name="codigo" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="percentual" class="java.math.BigDecimal"/>
    <field name="motivoIsencaoCodigo" class="java.lang.String"/>
    <field name="motivoIsencaoDescricao" class="java.lang.String"/>
    <field name="totalFaturas" class="java.lang.Integer"/>
    <field name="baseTributavel" class="java.math.BigDecimal"/>
    <field name="valorImposto" class="java.math.BigDecimal"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>

    <!-- Variáveis -->
    <variable name="TOTAL_BASE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{baseTributavel}]]></variableExpression>
    </variable>
    <variable name="TOTAL_IMPOSTO" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorImposto}]]></variableExpression>
    </variable>
    <variable name="TOTAL_GERAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valorTotal}]]></variableExpression>
    </variable>

    <!-- Título do Relatório -->
    <title>
        <band height="120" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="120" backcolor="#1976D2" uuid="20bc7132-3e62-483b-87fe-9ecb0b481787"/>
            </rectangle>
            <image>
                <reportElement x="20" y="20" width="80" height="80" uuid="a3c0160e-d08e-4072-880e-d79b65410195"/>
                <imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression>
            </image>
            <textField>
                <reportElement style="Title" x="120" y="20" width="415" height="25" forecolor="white" uuid="6365c1f9-75c7-4b0f-a492-31ec4324ef89"/>
                <textFieldExpression><![CDATA["RELATÓRIO DE IMPOSTOS"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Subtitle" x="120" y="50" width="415" height="15" forecolor="white" uuid="3506d263-55f1-4171-9f25-db0d82a9b98a"/>
                <textFieldExpression><![CDATA["Mapa de Tributação - " + $P{EMPRESA_NOME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="70" width="415" height="15" forecolor="white" fontSize="9" uuid="92163b87-41d4-472b-9378-240fb85e1ad8"/>
                <textFieldExpression><![CDATA["Período: " + $P{PERIODO_INICIO} + " até " + $P{PERIODO_FIM}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="120" y="90" width="200" height="15" forecolor="white" fontSize="8" uuid="c1065dd6-d3ce-4af6-9b53-b306742df05b"/>
                <textFieldExpression><![CDATA["Emitido em: " + new java.util.Date()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="90" width="135" height="15" forecolor="white" fontSize="8" uuid="40ca0614-a259-4656-b943-0f98b498faae"/>
                <textFieldExpression><![CDATA["Usuário: " + $P{USUARIO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Cabeçalho da Página -->
    <pageHeader>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="30" backcolor="#F0F4F8" uuid="c079fe7b-fc8b-49e9-a823-36472c819332"/>
            </rectangle>
            <textField>
                <reportElement x="10" y="8" width="300" height="15" fontSize="9" isBold="true" uuid="45ebda2c-e3d6-4ad3-bd2b-fb85f3ff2b6a"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME} + " - NIF: " + $P{EMPRESA_NIF}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="8" width="145" height="15" fontSize="9" isBold="true" uuid="e842d7a3-fd05-420f-a0c2-f95c5f372705"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Coluna de Agrupamento por Tipo de Imposto -->
    <group name="TipoImpostoGroup">
        <groupExpression><![CDATA[$F{tipo}]]></groupExpression>
        <groupHeader>
            <band height="25">
                <rectangle>
                    <reportElement x="0" y="0" width="555" height="25" backcolor="#E3F2FD" uuid="eb9a5348-8ceb-44cb-a698-d39235c7f481"/>
                </rectangle>
                <textField>
                    <reportElement style="Highlight" x="10" y="5" width="200" height="15" uuid="e8050895-bbf3-48ac-b756-336cb2246087"/>
                    <textFieldExpression><![CDATA["TIPO: " + $F{tipo}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="400" y="5" width="145" height="15" fontSize="9" isBold="true" uuid="3ed4913d-3a81-45e1-a493-163e24bd1ceb"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total do Tipo: " + new java.text.DecimalFormat("#,##0.00").format($V{TOTAL_IMPOSTO})]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <rectangle>
                    <reportElement x="0" y="0" width="555" height="20" backcolor="#F5F5F5" uuid="5c49fd57-b00b-44f2-bf3b-5338028aad4b"/>
                </rectangle>
                <textField>
                    <reportElement style="Total" x="10" y="3" width="300" height="15" uuid="9c9b1195-06a5-4e7a-b7d2-2eb137495ac9"/>
                    <textFieldExpression><![CDATA["TOTAL " + $F{tipo} + ":"]]></textFieldExpression>
                </textField>
                <textField pattern="# ,##0.00 AOA">
                    <reportElement style="Total" x="400" y="3" width="145" height="15" uuid="7713ce9e-ab7d-4e06-9677-ad778fe8cfdb"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$V{TOTAL_GERAL}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <!-- Cabeçalho da Tabela -->
    <columnHeader>
        <band height="25" splitType="Stretch">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="80" height="25" uuid="b144befb-be10-4803-9262-4a27d71bcd02"/>
                <text><![CDATA[CÓDIGO]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="80" y="0" width="150" height="25" uuid="50ba9a2f-d439-4317-a432-9b3875684c39"/>
                <text><![CDATA[DESCRIÇÃO]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="230" y="0" width="80" height="25" uuid="9ee8a76b-d36e-48cb-ae98-686e4ea076a9"/>
                <text><![CDATA[TAXA (%)]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="310" y="0" width="120" height="25" uuid="c9718c3c-6897-4320-bbbc-96167819e185"/>
                <text><![CDATA[MOTIVO ISENÇÃO]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="430" y="0" width="125" height="25" uuid="8eb5f1e0-a363-4915-94d7-63ab0ce83f29"/>
                <text><![CDATA[VALOR TOTAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalhes -->
    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement style="TableDetail" x="0" y="0" width="80" height="20" uuid="3ed6f38e-5bfe-4b3f-8d3f-3a31eb3d7142"/>
                <textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableDetail" x="80" y="0" width="150" height="20" uuid="cafe668a-fb8f-4941-8b2c-db8bb987b0f1"/>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>
            <textField pattern="# ,##0.00 %">
                <reportElement style="TableDetail" x="230" y="0" width="80" height="20" uuid="2bd7d7b4-602b-4146-bd33-efc63e7abba3"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{percentual}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableDetail" x="310" y="0" width="120" height="20" uuid="085adbd8-2ac9-4865-a7f4-c6413f76533c"/>
                <textFieldExpression><![CDATA[$F{motivoIsencaoCodigo} != null ? $F{motivoIsencaoCodigo} + " - " + $F{motivoIsencaoDescricao} : "-"]]></textFieldExpression>
            </textField>
            <textField pattern="# ,##0.00 AOA">
                <reportElement style="TableDetail" x="430" y="0" width="125" height="20" uuid="cd6ff2ca-a706-44f9-b3d5-b6f5914c4869"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Resumo Final -->
    <summary>
        <band height="100" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="100" backcolor="#E8F5E8" uuid="a73f11e8-f3de-4852-95aa-43c0c3fcba65"/>
            </rectangle>
            <staticText>
                <reportElement style="Highlight" x="10" y="10" width="200" height="15" uuid="a05b19a1-b517-4cd5-99b9-4a444ba2a826"/>
                <text><![CDATA[RESUMO DO RELATÓRIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="35" width="200" height="15" fontSize="10" isBold="true" uuid="62e5556c-529b-4462-aab5-772f4a78e921"/>
                <text><![CDATA[TOTAL BASE TRIBUTÁVEL:]]></text>
            </staticText>
            <textField pattern="# ,##0.00 AOA">
                <reportElement x="220" y="35" width="150" height="15" fontSize="10" isBold="true" uuid="b0977a79-8319-4d60-ab52-1ae3a8255bb7"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$V{TOTAL_BASE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="55" width="200" height="15" fontSize="10" isBold="true" uuid="2a29760e-ed7e-4d18-afbc-f9eb0340d353"/>
                <text><![CDATA[TOTAL DE IMPOSTOS:]]></text>
            </staticText>
            <textField pattern="# ,##0.00 AOA">
                <reportElement x="220" y="55" width="150" height="15" fontSize="10" isBold="true" uuid="8eb8f597-d333-4d97-95ca-cd7e11582fac"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$V{TOTAL_IMPOSTO}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="75" width="200" height="15" fontSize="10" isBold="true" uuid="5e168758-2867-4122-b0ec-136a725e3c09"/>
                <text><![CDATA[TOTAL GERAL:]]></text>
            </staticText>
            <textField pattern="# ,##0.00 AOA">
                <reportElement x="220" y="75" width="150" height="15" fontSize="10" isBold="true" uuid="dd7b2d09-7b45-4367-8e41-a9b88015c343"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$V{TOTAL_GERAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Footer" x="10" y="90" width="535" height="10" uuid="06240061-5b1c-4db4-8a87-ce70ef9754df"/>
                <textFieldExpression><![CDATA["Emitido por: " + $P{USUARIO} + " em " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <!-- Rodapé -->
    <pageFooter>
        <band height="25" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#F5F5F5" uuid="1226b5b6-521a-4c15-90eb-ef00884971f2"/>
            </rectangle>
            <textField>
                <reportElement style="Footer" x="10" y="5" width="300" height="15" uuid="6155b1e8-ea10-4d9a-b8b0-4458f799de1e"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME} + " | " + $P{EMPRESA_ENDERECO} + " | Tel: " + $P{EMPRESA_TELEFONE}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm:ss">
                <reportElement style="Footer" x="400" y="5" width="145" height="15" uuid="3f3fa335-a1af-4854-9ba2-089184f4d0a6"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>

