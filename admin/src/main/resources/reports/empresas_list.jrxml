<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="empresas_list" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="22" bottomMargin="22"
              uuid="c1e690a3-5977-4467-85f8-6b0bcd5b7210">

    <style name="KBase" fontName="DejaVu Sans" fontSize="9" forecolor="#263238"/>
    <style name="KTitle" fontSize="18" isBold="true" forecolor="#0A6B4A"/>
    <style name="KMuted" fontSize="9" forecolor="#607D8B"/>
    <style name="KHeader" fontSize="9" isBold="true" forecolor="#FFFFFF"
           backcolor="#0A6B4A" mode="Opaque"/>
    <style name="KDetail" backcolor="#FFFFFF" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F5F8F7" mode="Opaque"/>
        </conditionalStyle>
    </style>
    <style name="KFooter" fontSize="8" forecolor="#607D8B"/>

    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>

    <field name="nome" class="java.lang.String"/>
    <field name="nif" class="java.lang.String"/>
    <field name="identificador" class="java.lang.String"/>
    <field name="ativa" class="java.lang.Boolean"/>
    <field name="anoInicio" class="java.lang.Integer"/>

    <background><band splitType="Stretch"/></background>

    <title>
        <band height="78" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="78" backcolor="#F4F8F6"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField style="KTitle">
                <reportElement x="18" y="10" width="340" height="26" uuid="a1b2c3d4-5678-90ab-cdef-123456789012"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression>
            </textField>
            <staticText style="KBase">
                <reportElement x="370" y="10" width="167" height="26" uuid="b2c3d4e5-6789-01ab-cdef-234567890123"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[Listagem de Empresas]]></text>
            </staticText>
            <textField style="KMuted">
                <reportElement x="18" y="40" width="260" height="17"/>
                <textFieldExpression><![CDATA["NIF: " + ($P{EMPRESA_NIF} == null ? "—" : $P{EMPRESA_NIF})]]></textFieldExpression>
            </textField>
            <textField style="KMuted" pattern="dd/MM/yyyy HH:mm">
                <reportElement x="300" y="40" width="237" height="17"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Emitido em " + new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText style="KMuted">
                <reportElement x="18" y="59" width="519" height="14"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Catálogo administrativo · situação e exercício de cada empresa]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText style="KHeader">
                <reportElement x="0" y="0" width="180" height="30" uuid="c3d4e5f6-7890-12ab-cdef-345678901234"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[Empresa]]></text>
            </staticText>
            <staticText style="KHeader">
                <reportElement x="180" y="0" width="100" height="30" uuid="d4e5f6a7-8901-23ab-cdef-456789012345"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[NIF]]></text>
            </staticText>
            <staticText style="KHeader">
                <reportElement x="280" y="0" width="100" height="30" uuid="e5f6a7b8-9012-34ab-cdef-567890123456"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[Identificador]]></text>
            </staticText>
            <staticText style="KHeader">
                <reportElement x="380" y="0" width="80" height="30" uuid="f6a7b8c9-0123-45ab-cdef-678901234567"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Início]]></text>
            </staticText>
            <staticText style="KHeader">
                <reportElement x="460" y="0" width="95" height="30" uuid="a7b8c9d0-1234-56ab-cdef-789012345678"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField style="KDetail">
                <reportElement x="0" y="0" width="180" height="25" uuid="b8c9d0e1-2345-67ab-cdef-890123456789"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box>
                <textFieldExpression><![CDATA[$F{nome} == null ? "—" : $F{nome}]]></textFieldExpression>
            </textField>
            <textField style="KDetail">
                <reportElement x="180" y="0" width="100" height="25" uuid="c9d0e1f2-3456-78ab-cdef-901234567890"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box>
                <textFieldExpression><![CDATA[$F{nif} == null ? "—" : $F{nif}]]></textFieldExpression>
            </textField>
            <textField style="KDetail">
                <reportElement x="280" y="0" width="100" height="25" uuid="d0e1f2a3-4567-89ab-cdef-012345678901"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box>
                <textFieldExpression><![CDATA[$F{identificador} == null ? "—" : $F{identificador}]]></textFieldExpression>
            </textField>
            <textField style="KDetail">
                <reportElement x="380" y="0" width="80" height="25" uuid="e1f2a3b4-5678-90ab-cdef-123456789012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box>
                <textFieldExpression><![CDATA[$F{anoInicio} == null ? "—" : $F{anoInicio}]]></textFieldExpression>
            </textField>
            <textField style="KDetail">
                <reportElement x="460" y="0" width="95" height="25" uuid="f2a3b4c5-6789-01ab-cdef-234567890123"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box>
                <textFieldExpression><![CDATA[Boolean.TRUE.equals($F{ativa}) ? "Activa" : "Inactiva"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="34">
            <line><reportElement x="0" y="0" width="555" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#D7E2DE"/></graphicElement></line>
            <staticText style="KFooter">
                <reportElement x="0" y="9" width="300" height="18"/>
                <text><![CDATA[Kubata Administrator · Documento de gestão interna]]></text>
            </staticText>
            <textField style="KFooter">
                <reportElement x="365" y="9" width="85" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField style="KFooter" evaluationTime="Report">
                <reportElement x="450" y="9" width="85" height="18"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>