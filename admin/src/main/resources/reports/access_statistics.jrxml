<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="access_statistics" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="22" bottomMargin="22"
              uuid="d1e690a3-5977-4467-85f8-6b0bcd5b7210">

    <style name="KBase" fontName="DejaVu Sans" fontSize="8" forecolor="#263238"/>
    <style name="KTitle" parentStyle="KBase" fontSize="18" isBold="true" forecolor="#0A6B4A"/>
    <style name="KMuted" parentStyle="KBase" fontSize="8" forecolor="#607D8B"/>
    <style name="KHeader" parentStyle="KBase" fontSize="8" isBold="true" forecolor="#FFFFFF" backcolor="#0A6B4A" mode="Opaque"/>
    <style name="KDetail" parentStyle="KBase" backcolor="#FFFFFF" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F5F8F7" mode="Opaque"/>
        </conditionalStyle>
    </style>
    <style name="KFooter" parentStyle="KBase" fontSize="7" forecolor="#607D8B"/>

    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>
    <parameter name="PERIODO_INICIO" class="java.lang.String"/>
    <parameter name="PERIODO_FIM" class="java.lang.String"/>

    <field name="username" class="java.lang.String"/>
    <field name="loginTime" class="java.time.LocalDateTime"/>
    <field name="logoutTime" class="java.time.LocalDateTime"/>
    <field name="durationMinutes" class="java.lang.Long"/>
    <field name="ipAddress" class="java.lang.String"/>
    <field name="module" class="java.lang.String"/>
    <field name="actionsCount" class="java.lang.Integer"/>

    <title>
        <band height="76">
            <rectangle><reportElement x="0" y="0" width="802" height="76" backcolor="#F4F8F6"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField style="KTitle"><reportElement x="18" y="9" width="430" height="25"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression></textField>
            <staticText style="KBase"><reportElement x="500" y="9" width="284" height="25"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><text><![CDATA[Estatísticas de Acesso]]></text></staticText>
            <textField style="KMuted"><reportElement x="18" y="36" width="330" height="16"/><textFieldExpression><![CDATA["NIF: " + ($P{EMPRESA_NIF} == null ? "—" : $P{EMPRESA_NIF})]]></textFieldExpression></textField>
            <textField style="KMuted"><reportElement x="360" y="36" width="424" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Período: " + ($P{PERIODO_INICIO} == null ? "Início" : $P{PERIODO_INICIO}) + " → " + ($P{PERIODO_FIM} == null ? "Fim" : $P{PERIODO_FIM})]]></textFieldExpression></textField>
            <staticText style="KMuted"><reportElement x="18" y="56" width="766" height="13"/><text><![CDATA[Resumo de sessões e actividade dos utilizadores no Kubata]]></text></staticText>
        </band>
    </title>

    <columnHeader>
        <band height="27">
            <staticText style="KHeader"><reportElement x="0" y="0" width="100" height="27"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Utilizador]]></text></staticText>
            <staticText style="KHeader"><reportElement x="100" y="0" width="120" height="27"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Login]]></text></staticText>
            <staticText style="KHeader"><reportElement x="220" y="0" width="120" height="27"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Logout]]></text></staticText>
            <staticText style="KHeader"><reportElement x="340" y="0" width="80" height="27"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="6"/></textElement><text><![CDATA[Duração (min)]]></text></staticText>
            <staticText style="KHeader"><reportElement x="420" y="0" width="120" height="27"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Endereço IP]]></text></staticText>
            <staticText style="KHeader"><reportElement x="540" y="0" width="100" height="27"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Módulo]]></text></staticText>
            <staticText style="KHeader"><reportElement x="640" y="0" width="80" height="27"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[Ações]]></text></staticText>
            <staticText style="KHeader"><reportElement x="720" y="0" width="82" height="27"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[Estado]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField style="KDetail"><reportElement x="0" y="0" width="100" height="24"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{username} == null ? "—" : $F{username}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="dd/MM/yyyy HH:mm"><reportElement x="100" y="0" width="120" height="24"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{loginTime}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="220" y="0" width="120" height="24"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{logoutTime} == null ? "Em sessão" : $F{logoutTime}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="#,##0"><reportElement x="340" y="0" width="80" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{durationMinutes} == null ? 0 : $F{durationMinutes}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="420" y="0" width="120" height="24"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{ipAddress} == null ? "—" : $F{ipAddress}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="540" y="0" width="100" height="24"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{module} == null ? "—" : $F{module}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="#,##0"><reportElement x="640" y="0" width="80" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{actionsCount} == null ? 0 : $F{actionsCount}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="720" y="0" width="82" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{logoutTime} == null ? "Ativo" : "Concluído"]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="34">
            <line><reportElement x="0" y="0" width="802" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#D7E2DE"/></graphicElement></line>
            <staticText style="KFooter"><reportElement x="0" y="9" width="390" height="18"/><text><![CDATA[Kubata Administrator · Relatório de segurança operacional]]></text></staticText>
            <textField style="KFooter"><reportElement x="645" y="9" width="75" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
            <textField style="KFooter" evaluationTime="Report"><reportElement x="720" y="9" width="82" height="18"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>