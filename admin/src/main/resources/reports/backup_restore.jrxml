<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="backup_restore" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="22" bottomMargin="22"
              uuid="e1e690a3-5977-4467-85f8-6b0bcd5b7210">

    <style name="KBase" fontName="DejaVu Sans" fontSize="8" forecolor="#263238"/>
    <style name="KTitle" parentStyle="KBase" fontSize="18" isBold="true" forecolor="#0A6B4A"/>
    <style name="KMuted" parentStyle="KBase" fontSize="8" forecolor="#607D8B"/>
    <style name="KHeader" parentStyle="KBase" fontSize="8" isBold="true" forecolor="#FFFFFF" backcolor="#0A6B4A" mode="Opaque"/>
    <style name="KDetail" parentStyle="KBase" backcolor="#FFFFFF" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F5F8F7" mode="Opaque"/>
        </conditionalStyle>
    </style>
    <style name="KFooter" parentStyle="KBase" fontSize="7" forecolor="#607D8B"/>

    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>
    <parameter name="PERIODO_INICIO" class="java.lang.String"/>
    <parameter name="PERIODO_FIM" class="java.lang.String"/>

    <field name="backupId" class="java.lang.String"/>
    <field name="backupDate" class="java.time.LocalDateTime"/>
    <field name="backupType" class="java.lang.String"/>
    <field name="backupSize" class="java.lang.Long"/>
    <field name="backupPath" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="createdBy" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="restoreDate" class="java.time.LocalDateTime"/>
    <field name="restoredBy" class="java.lang.String"/>

    <background><band splitType="Stretch"/></background>

    <title>
        <band height="82">
            <rectangle><reportElement x="0" y="0" width="802" height="82" backcolor="#F4F8F6"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
            <textField style="KTitle"><reportElement x="18" y="10" width="430" height="26"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression></textField>
            <staticText style="KBase"><reportElement x="500" y="10" width="284" height="26"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><text><![CDATA[Backup e Restauro]]></text></staticText>
            <textField style="KMuted"><reportElement x="18" y="39" width="330" height="16"/><textFieldExpression><![CDATA["NIF: " + ($P{EMPRESA_NIF} == null ? "—" : $P{EMPRESA_NIF})]]></textFieldExpression></textField>
            <textField style="KMuted"><reportElement x="360" y="39" width="424" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Período: " + ($P{PERIODO_INICIO} == null ? "Início" : $P{PERIODO_INICIO}) + " → " + ($P{PERIODO_FIM} == null ? "Fim" : $P{PERIODO_FIM})]]></textFieldExpression></textField>
            <staticText style="KMuted"><reportElement x="18" y="59" width="766" height="14"/><text><![CDATA[Histórico de continuidade operacional · cópias de segurança e operações de restauro]]></text></staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText style="KHeader"><reportElement x="0" y="0" width="80" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText style="KHeader"><reportElement x="80" y="0" width="105" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Data]]></text></staticText>
            <staticText style="KHeader"><reportElement x="185" y="0" width="75" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Tipo]]></text></staticText>
            <staticText style="KHeader"><reportElement x="260" y="0" width="85" height="28"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="6"/></textElement><text><![CDATA[Tamanho MB]]></text></staticText>
            <staticText style="KHeader"><reportElement x="345" y="0" width="78" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Criado por]]></text></staticText>
            <staticText style="KHeader"><reportElement x="423" y="0" width="70" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[Estado]]></text></staticText>
            <staticText style="KHeader"><reportElement x="493" y="0" width="105" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Restauro]]></text></staticText>
            <staticText style="KHeader"><reportElement x="598" y="0" width="78" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Utilizador]]></text></staticText>
            <staticText style="KHeader"><reportElement x="676" y="0" width="126" height="28"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Descrição]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField style="KDetail"><reportElement x="0" y="0" width="80" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{backupId} == null ? "—" : $F{backupId}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="dd/MM/yyyy HH:mm"><reportElement x="80" y="0" width="105" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{backupDate}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="185" y="0" width="75" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{backupType} == null ? "—" : $F{backupType}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="#,##0.00"><reportElement x="260" y="0" width="85" height="25"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{backupSize} == null ? 0D : $F{backupSize}.doubleValue() / 1024D / 1024D]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="345" y="0" width="78" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{createdBy} == null ? "—" : $F{createdBy}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="423" y="0" width="70" height="25"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{status} == null ? "—" : $F{status}]]></textFieldExpression></textField>
            <textField style="KDetail" pattern="dd/MM/yyyy HH:mm"><reportElement x="493" y="0" width="105" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{restoreDate} == null ? "—" : $F{restoreDate}]]></textFieldExpression></textField>
            <textField style="KDetail"><reportElement x="598" y="0" width="78" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{restoredBy} == null ? "—" : $F{restoredBy}]]></textFieldExpression></textField>
            <textField style="KDetail" isStretchWithOverflow="true"><reportElement x="676" y="0" width="126" height="25"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{description} == null ? "—" : $F{description}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="34">
            <line><reportElement x="0" y="0" width="802" height="1"/><graphicElement><pen lineWidth="0.5" lineColor="#D7E2DE"/></graphicElement></line>
            <staticText style="KFooter"><reportElement x="0" y="9" width="400" height="18"/><text><![CDATA[Kubata Administrator · Relatório de continuidade operacional]]></text></staticText>
            <textField style="KFooter"><reportElement x="645" y="9" width="75" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
            <textField style="KFooter" evaluationTime="Report"><reportElement x="720" y="9" width="82" height="18"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>