    </columnHeader>

    <detail>
        <band height="24" splitType="Stretch">
            <textField><reportElement style="KDetail" x="0" y="0" width="120" height="24" uuid="e1f2a3b4-5678-90ab-cdef-123456789002"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{timestamp} == null ? "—" : $F{timestamp}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss"))]]></textFieldExpression></textField>
            <textField><reportElement style="KDetail" x="120" y="0" width="80" height="24" uuid="f2a3b4c5-6789-01ab-cdef-234567890013"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{username} == null ? "—" : $F{username}]]></textFieldExpression></textField>
