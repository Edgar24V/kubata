            <textField isStretchWithOverflow="true"><reportElement style="KDetail" x="400" y="0" width="342" height="24" uuid="c5d6e7f8-9012-34ab-cdef-567890012346"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textFieldExpression><![CDATA[$F{newValues} == null ? "—" : $F{newValues}]]></textFieldExpression></textField>
