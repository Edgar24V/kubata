    <style name="KBase" fontName="DejaVu Sans" fontSize="8" forecolor="#263238"/>
    <style name="KTitle" fontSize="18" isBold="true" forecolor="#0A6B4A"/>
    <style name="KMuted" fontSize="8" forecolor="#607D8B"/>
    <style name="KHeader" fontSize="8" isBold="true" forecolor="#FFFFFF"
           backcolor="#0A6B4A" mode="Opaque"/>
    <style name="KDetail" backcolor="#FFFFFF" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F5F8F7" mode="Opaque"/>
        </conditionalStyle>
    </style>
    <style name="KFooter" fontSize="7" forecolor="#607D8B"/>

    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>
    <parameter name="PERIODO_INICIO" class="java.lang.String"/>
    <parameter name="PERIODO_FIM" class="java.lang.String"/>

    <field name="timestamp" class="java.time.LocalDateTime"/>
    <field name="username" class="java.lang.String"/>
    <field name="actionType" class="java.lang.String"/>
    <field name="entityType" class="java.lang.String"/>
    <field name="newValues" class="java.lang.String"/>
    <field name="duracaoMs" class="java.lang.Long"/>

    <background><band splitType="Stretch"/></background>

    <title>
        <band height="76">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="76" backcolor="#F4F8F6"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement style="KTitle" x="18" y="9" width="430" height="25"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="KBase" x="500" y="9" width="284" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Histórico de Auditoria]]></text>
            </staticText>
            <textField>
                <reportElement style="KMuted" x="18" y="36" width="350" height="16"/>
                <textFieldExpression><![CDATA["NIF: " + ($P{EMPRESA_NIF} == null ? "—" : $P{EMPRESA_NIF})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="KMuted" x="380" y="36" width="404" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Período: " + ($P{PERIODO_INICIO} == null ? "Início" : $P{PERIODO_INICIO}) + " → " + ($P{PERIODO_FIM} == null ? "Fim" : $P{PERIODO_FIM})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="KMuted" x="18" y="56" width="766" height="13"/>
                <text><![CDATA[Trilha de auditoria · registo operacional do Kubata · os detalhes apresentados correspondem aos dados recebidos pelo relatório]]></text>
            </staticText>
        </band>
    </title>

