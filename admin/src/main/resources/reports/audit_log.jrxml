            <staticText><reportElement style="KHeader" x="400" y="0" width="342" height="26" uuid="c9d0e1f2-3456-78ab-cdef-901234567890"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[Detalhes]]></text></staticText>
