              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="users_list" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="22" bottomMargin="22"
              uuid="a1f690a3-5977-4467-85f8-6b0bcd5b7210">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <style name="KBase" fontName="DejaVu Sans" fontSize="9" forecolor="#263238"/>
    <style name="KTitle" fontSize="18" isBold="true" forecolor="#0A6B4A"/>
    <style name="KSubtitle" fontSize="9" forecolor="#546E7A"/>
    <style name="KHeader" fontSize="9" isBold="true" forecolor="#FFFFFF"
           backcolor="#0A6B4A" mode="Opaque"/>
    <style name="KDetail" fontName="DejaVu Sans" fontSize="9" forecolor="#263238" backcolor="#FFFFFF" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F5F8F7" mode="Opaque"/>
        </conditionalStyle>
    </style>
    <style name="KFooter" fontSize="8" forecolor="#607D8B"/>
    <style name="KBadge" fontSize="8" isBold="true" forecolor="#0A6B4A"/>

    <parameter name="EMPRESA_NOME" class="java.lang.String"/>
    <parameter name="EMPRESA_NIF" class="java.lang.String"/>
    <parameter name="PERIODO_INICIO" class="java.lang.String"/>
    <parameter name="PERIODO_FIM" class="java.lang.String"/>

    <queryString><![CDATA[]]></queryString>

    <field name="nome" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="role" class="java.lang.Object"/>
    <field name="active" class="java.lang.Boolean"/>

    <background><band splitType="Stretch"/></background>

    <title>
        <band height="86" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="86" backcolor="#F4F8F6" uuid="b1f690a3-5977-4467-85f8-6b0bcd5b7210"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement style="KTitle" x="18" y="10" width="350" height="26" uuid="c2b535d4-4f51-460d-85f1-3312217f26d2"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{EMPRESA_NOME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="KBase" x="385" y="10" width="150" height="26" uuid="42c8d28e-671c-43f1-b9e3-28f08f1f5168"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Lista de Utilizadores]]></text>
            </staticText>
            <textField>
                <reportElement style="KSubtitle" x="18" y="38" width="300" height="17" uuid="a63e9f3b-d54e-41a6-880c-7b003a29929d"/>
                <textFieldExpression><![CDATA["NIF: " + ($P{EMPRESA_NIF} == null ? "—" : $P{EMPRESA_NIF})]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement style="KSubtitle" x="335" y="38" width="200" height="17" uuid="e6224151-5120-431f-bc87-19598e87d825"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Emitido em " + new java.util.Date()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="KSubtitle" x="18" y="58" width="517" height="16"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA["Período: " + ($P{PERIODO_INICIO} == null || $P{PERIODO_INICIO}.isBlank() ? "Início" : $P{PERIODO_INICIO}) + " → " + ($P{PERIODO_FIM} == null || $P{PERIODO_FIM}.isBlank() ? "Fim" : $P{PERIODO_FIM})]]></textFieldExpression>
            </textField>
        </band>
    </title>

