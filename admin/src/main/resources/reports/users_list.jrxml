        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField>
                <reportElement style="KDetail" x="0" y="0" width="180" height="25" uuid="4f9d227c-959c-486a-845b-785d0d829370"/>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                
                <textFieldExpression><![CDATA[$F{nome} == null ? "—" : $F{nome}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="KDetail" x="180" y="0" width="175" height="25" uuid="6a715f21-7292-4161-9c60-59a8509b53e3"/>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                
                <textFieldExpression><![CDATA[$F{email} == null ? "—" : $F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="KDetail" x="355" y="0" width="100" height="25" uuid="6a34c51f-5061-424a-a471-92b0c1693f8e"/>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textElement verticalAlignment="Middle"><paragraph leftIndent="8"/></textElement>
                
                <textFieldExpression><![CDATA[$F{role} == null ? "—" : String.valueOf($F{role})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="KDetail" x="455" y="0" width="100" height="25" uuid="69a19c5b-3129-4700-9884-60170a312480"/>
                <box><bottomPen lineWidth="0.35" lineColor="#D7E2DE"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                
