<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="contratos_expirar" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="DATA_EMISSAO" class="java.lang.String"/>
    <parameter name="DATA_LIMITE" class="java.lang.String"/>
    <parameter name="DIAS" class="java.lang.Integer"/>
    <parameter name="TOTAL_REGISTROS" class="java.lang.Integer"/>

    <field name="colaborador.nomeCompleto" class="java.lang.String"/>
    <field name="tipoContrato" class="java.lang.String"/>
    <field name="situacao" class="java.lang.String"/>
    <field name="dataFim" class="java.time.LocalDate"/>

    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="555" height="28"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="555" height="14"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Data: " + $P{DATA_EMISSAO} + " | Até: " + $P{DATA_LIMITE} + " (" + $P{DIAS} + " dias)" ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="48" width="555" height="14"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Total: " + $P{TOTAL_REGISTROS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="260" height="20" backcolor="#EEEEEE" mode="Opaque"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Colaborador]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="120" height="20" backcolor="#EEEEEE" mode="Opaque"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="90" height="20" backcolor="#EEEEEE" mode="Opaque"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Situação]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="85" height="20" backcolor="#EEEEEE" mode="Opaque"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Fim]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="260" height="18"/>
                <textFieldExpression><![CDATA[$F{colaborador.nomeCompleto}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="120" height="18"/>
                <textFieldExpression><![CDATA[$F{tipoContrato}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="0" width="90" height="18"/>
                <textFieldExpression><![CDATA[$F{situacao}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="470" y="0" width="85" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{dataFim}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="555" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
